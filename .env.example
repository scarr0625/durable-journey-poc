# PostgreSQL / Cloud SQL (use the Cloud SQL Auth Proxy endpoint locally)
DATABASE_URL=postgresql+psycopg://journey:change-me@127.0.0.1:5432/durable_journey

# Choose one Google ADK authentication mode.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=replace-with-a-Gemini-API-key

# When using Vertex AI instead:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

JOURNEY_AGENT_MODEL=gemini-2.5-flash
SQL_ECHO=false
