# Local deployment configuration. Copy to .env.gcp; never commit .env.gcp.
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1
AGENT_DISPLAY_NAME=Durable Cloud Compass
AGENT_STAGING_BUCKET=gs://your-project-agent-staging
AGENT_SERVICE_ACCOUNT=cloud-compass-agent@your-project-id.iam.gserviceaccount.com

# Cloud SQL Python Connector configuration used inside Agent Runtime.
DEPLOY_CLOUD_SQL_INSTANCE=your-project-id:us-central1:your-postgres-instance
DEPLOY_CLOUD_SQL_IP_TYPE=PUBLIC
DEPLOY_DB_NAME=durable_journey
DEPLOY_DB_USER=journey
DEPLOY_DB_POOL_SIZE=5
DEPLOY_DB_MAX_OVERFLOW=2

# Password authentication: store the password in Secret Manager.
DEPLOY_CLOUD_SQL_IAM_AUTH=false
DB_PASSWORD_SECRET=cloud-compass-db-password
DB_PASSWORD_SECRET_VERSION=latest

# Or use automatic IAM database authentication and omit DB_PASSWORD_SECRET.
# DEPLOY_CLOUD_SQL_IAM_AUTH=true
# DEPLOY_DB_USER=cloud-compass-agent@your-project-id.iam

DEPLOY_JOURNEY_AGENT_MODEL=gemini-2.5-flash
AGENT_MIN_INSTANCES=0
AGENT_MAX_INSTANCES=2

# Set this after deployment for scripts/query_remote_agent.py.
AGENT_RESOURCE_NAME=projects/your-project-id/locations/us-central1/reasoningEngines/RESOURCE_ID
